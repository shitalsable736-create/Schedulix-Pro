rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprint: Task
    function isValidTask(data) {
      return data.keys().hasAll([
        'ownerId',
        'title',
        'subject',
        'dueDate',
        'priority',
        'progress',
        'status',
        'source',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'title',
        'subject',
        'dueDate',
        'priority',
        'progress',
        'status',
        'source',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId.size() >= 1 &&
      data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.title is string &&
      data.title.size() >= 1 &&
      data.title.size() <= 200 &&
      data.subject is string &&
      data.subject.size() >= 1 &&
      data.subject.size() <= 120 &&
      data.dueDate is string &&
      data.dueDate.size() == 10 &&
      data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.priority is string &&
      data.priority in ['high', 'medium', 'low'] &&
      data.progress is int &&
      data.progress >= 0 &&
      data.progress <= 100 &&
      data.status is string &&
      data.status in ['pending', 'completed'] &&
      data.source is string &&
      data.source in ['manual', 'todoist', 'notion', 'google_tasks', 'ai'] &&
      data.createdAt is timestamp &&
      data.createdAt <= request.time &&
      data.updatedAt is timestamp &&
      data.updatedAt <= request.time;
    }

    // Validation Blueprint: ClassSession
    function isValidClassSession(data) {
      return data.keys().hasAll([
        'ownerId',
        'subject',
        'day',
        'time',
        'room',
        'teacher',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'subject',
        'day',
        'time',
        'room',
        'teacher',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId.size() >= 1 &&
      data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.subject is string &&
      data.subject.size() >= 1 &&
      data.subject.size() <= 120 &&
      data.day is string &&
      data.day in ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'] &&
      data.time is string &&
      data.time.size() >= 1 &&
      data.time.size() <= 50 &&
      data.room is string &&
      data.room.size() >= 1 &&
      data.room.size() <= 100 &&
      data.teacher is string &&
      data.teacher.size() >= 1 &&
      data.teacher.size() <= 100 &&
      data.createdAt is timestamp &&
      data.createdAt <= request.time &&
      data.updatedAt is timestamp &&
      data.updatedAt <= request.time;
    }

    // Validation Blueprint: Exam
    function isValidExam(data) {
      return data.keys().hasAll([
        'ownerId',
        'title',
        'subject',
        'date',
        'time',
        'room',
        'weight',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId',
        'title',
        'subject',
        'date',
        'time',
        'room',
        'weight',
        'createdAt',
        'updatedAt'
      ]) &&
      data.ownerId is string &&
      data.ownerId.size() >= 1 &&
      data.ownerId.size() <= 128 &&
      data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.title is string &&
      data.title.size() >= 1 &&
      data.title.size() <= 200 &&
      data.subject is string &&
      data.subject.size() >= 1 &&
      data.subject.size() <= 120 &&
      data.date is string &&
      data.date.size() == 10 &&
      data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.time is string &&
      data.time.size() >= 1 &&
      data.time.size() <= 40 &&
      data.room is string &&
      data.room.size() >= 1 &&
      data.room.size() <= 100 &&
      data.weight is int &&
      data.weight >= 1 &&
      data.weight <= 100 &&
      data.createdAt is timestamp &&
      data.createdAt <= request.time &&
      data.updatedAt is timestamp &&
      data.updatedAt <= request.time;
    }

    // Collection: /tasks/{taskId}
    match /tasks/{taskId} {
      allow get: if isSignedIn() && isValidId(taskId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(taskId) &&
        isValidTask(incoming());
      allow update: if isSignedIn() &&
        isValidId(taskId) &&
        isValidTask(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        existing().status != 'completed' &&
        (
          // Action 1: Progress or Status Update
          incoming().diff(existing()).affectedKeys().hasOnly(['progress', 'status', 'updatedAt']) ||
          // Action 2: Full Details Edit
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'subject',
            'dueDate',
            'priority',
            'progress',
            'status',
            'source',
            'updatedAt'
          ])
        );
      allow delete: if isSignedIn() && isValidId(taskId) && existing().ownerId == request.auth.uid;
    }

    // Collection: /classes/{classId}
    match /classes/{classId} {
      allow get: if isSignedIn() && isValidId(classId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(classId) &&
        isValidClassSession(incoming());
      allow update: if isSignedIn() &&
        isValidId(classId) &&
        isValidClassSession(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'subject',
          'day',
          'time',
          'room',
          'teacher',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(classId) && existing().ownerId == request.auth.uid;
    }

    // Collection: /exams/{examId}
    match /exams/{examId} {
      allow get: if isSignedIn() && isValidId(examId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(examId) &&
        isValidExam(incoming());
      allow update: if isSignedIn() &&
        isValidId(examId) &&
        isValidExam(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'subject',
          'date',
          'time',
          'room',
          'weight',
          'updatedAt'
        ]);
      allow delete: if isSignedIn() && isValidId(examId) && existing().ownerId == request.auth.uid;
    }
  }
}
